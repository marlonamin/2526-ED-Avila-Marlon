using System;
using System.Collections.Generic;

class Biblioteca
{
    static void Main()
    {
        HashSet<string> codigos = new HashSet<string>();
        Dictionary<string, string> libros = new Dictionary<string, string>();

        int opcion;

        do
        {
            Console.WriteLine("\n--- SISTEMA DE BIBLIOTECA ---");
            Console.WriteLine("1. Registrar libro");
            Console.WriteLine("2. Consultar libro");
            Console.WriteLine("3. Mostrar todos los libros");
            Console.WriteLine("4. Salir");
            Console.Write("Seleccione una opción: ");

            opcion = int.Parse(Console.ReadLine());

            switch (opcion)
            {
                case 1:
                    Console.Write("Ingrese código del libro: ");
                    string codigo = Console.ReadLine();

                    if (codigos.Contains(codigo))
                    {
                        Console.WriteLine("El libro ya existe.");
                    }
                    else
                    {
                        Console.Write("Ingrese título del libro: ");
                        string titulo = Console.ReadLine();

                        codigos.Add(codigo);
                        libros[codigo] = titulo;

                        Console.WriteLine("Libro registrado correctamente.");
                    }
                    break;

                case 2:
                    Console.Write("Ingrese código del libro: ");
                    string buscar = Console.ReadLine();

                    if (libros.ContainsKey(buscar))
                    {
                        Console.WriteLine("Libro encontrado: " + libros[buscar]);
                    }
                    else
                    {
                        Console.WriteLine("Libro no encontrado.");
                    }
                    break;

                case 3:
                    Console.WriteLine("\nLista de libros registrados:");

                    foreach (var libro in libros)
                    {
                        Console.WriteLine("Código: " + libro.Key + " - Título: " + libro.Value);
                    }
                    break;
            }

        } while (opcion != 4);
    }
}