// Traductor básico Inglés <-> Español usando diccionarios
// Requisitos: +10 palabras iniciales, agregar palabras, traducir frases completas (solo palabras del diccionario)
// .NET 6+ (funciona también en otras versiones con ajustes mínimos)

using System;
using System.Collections.Generic;
using System.Text.RegularExpressions;

namespace TraductorDiccionario
{
    internal class Program
    {
        // Diccionario bidireccional (guarda pares en ambos sentidos)
        // Ignora mayúsculas/minúsculas
        private static readonly Dictionary<string, string> Dic = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        static void Main(string[] args)
        {
            CargarPalabrasIniciales();

            while (true)
            {
                Console.WriteLine("==================== MENÚ ====================");
                Console.WriteLine("1. Traducir una frase");
                Console.WriteLine("2. Agregar palabras al diccionario");
                Console.WriteLine("0. Salir");
                Console.Write("Seleccione una opción: ");
                string? opt = Console.ReadLine();

                Console.WriteLine();

                switch (opt)
                {
                    case "1":
                        TraducirFrase();
                        break;
                    case "2":
                        AgregarPalabra();
                        break;
                    case "0":
                        Console.WriteLine("Saliendo...");
                        return;
                    default:
                        Console.WriteLine("Opción inválida. Intente nuevamente.");
                        break;
                }

                Console.WriteLine();
            }
        }

        private static void CargarPalabrasIniciales()
        {
            // Lista base sugerida (mínimo 10). Se guarda en ambos sentidos.
            AgregarPar("time", "tiempo");
            AgregarPar("person", "persona");
            AgregarPar("year", "año");
            AgregarPar("way", "camino");       // también podría ser "forma"
            AgregarPar("day", "día");
            AgregarPar("thing", "cosa");
            AgregarPar("man", "hombre");
            AgregarPar("world", "mundo");
            AgregarPar("life", "vida");
            AgregarPar("hand", "mano");
            AgregarPar("part", "parte");
            AgregarPar("child", "niño");
            AgregarPar("eye", "ojo");
            AgregarPar("woman", "mujer");
            AgregarPar("place", "lugar");
            AgregarPar("work", "trabajo");
            AgregarPar("week", "semana");
            AgregarPar("case", "caso");
            AgregarPar("point", "punto");
            AgregarPar("government", "gobierno");
            AgregarPar("company", "empresa");
        }

        private static void TraducirFrase()
        {
            Console.Write("Ingrese una frase: ");
            string? frase = Console.ReadLine();

            if (string.IsNullOrWhiteSpace(frase))
            {
                Console.WriteLine("No ingresó ninguna frase.");
                return;
            }

            // Traduce solo "palabras" (secuencias de letras) y respeta signos/puntuación.
            // \p{L}+ reconoce letras Unicode (incluye tildes: áéíóúñ)
            string traducida = Regex.Replace(frase, @"\p{L}+", match =>
            {
                string palabra = match.Value;

                if (Dic.TryGetValue(palabra, out string? traduccion))
                    return AplicarFormato(palabra, traduccion);

                return palabra; // si no existe en el diccionario, se deja igual
            });

            Console.WriteLine("\nTraducción (parcial):");
            Console.WriteLine(traducida);
        }

        private static void AgregarPalabra()
        {
            Console.WriteLine("Agregar nueva palabra (se guardará en ambos sentidos).");

            Console.Write("Ingrese la palabra en INGLÉS: ");
            string? en = Console.ReadLine();

            Console.Write("Ingrese la palabra en ESPAÑOL: ");
            string? es = Console.ReadLine();

            if (string.IsNullOrWhiteSpace(en) || string.IsNullOrWhiteSpace(es))
            {
                Console.WriteLine("Entrada inválida. No se agregó nada.");
                return;
            }

            en = en.Trim();
            es = es.Trim();

            AgregarPar(en, es);

            Console.WriteLine($"Listo. '{en}' <-> '{es}' agregado al diccionario.");
        }

        private static void AgregarPar(string ingles, string espanol)
        {
            // Guardar ambas direcciones para traducir EN->ES y ES->EN
            Dic[ingles] = espanol;
            Dic[espanol] = ingles;
        }

        private static string AplicarFormato(string original, string traducida)
        {
            // Mantiene mayúsculas/minúsculas:
            // - TODO MAYÚSCULA => traducción en MAYÚSCULA
            // - Capitalizada => capitaliza traducción
            // - minúscula => deja traducción tal cual
            if (EsTodoMayuscula(original))
                return traducida.ToUpperInvariant();

            if (EsCapitalizada(original))
                return Capitalizar(traducida);

            return traducida;
        }

        private static bool EsTodoMayuscula(string s)
        {
            bool hayLetra = false;
            foreach (char c in s)
            {
                if (char.IsLetter(c))
                {
                    hayLetra = true;
                    if (!char.IsUpper(c)) return false;
                }
            }
            return hayLetra;
        }

        private static bool EsCapitalizada(string s)
        {
            if (string.IsNullOrEmpty(s)) return false;
            return char.IsLetter(s[0]) && char.IsUpper(s[0]);
        }

        private static string Capitalizar(string s)
        {
            if (string.IsNullOrEmpty(s)) return s;
            if (s.Length == 1) return s.ToUpperInvariant();
            return char.ToUpperInvariant(s[0]) + s.Substring(1);
        }
    }
}